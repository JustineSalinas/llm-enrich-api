# Copy this file to .env and fill in real values. .env is git-ignored;
# .env.example (this file) is committed with no real values.

# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1/
LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter: your real key from https://openrouter.ai/settings/keys
# Ollama: the literal string "ollama" (required by the client, ignored by Ollama)
LLM_API_KEY=

# OpenRouter: openrouter/free
# Ollama: gemma3:1b or llama3.2:3b
LLM_MODEL=openrouter/free

# 1 = skip the model entirely, return a hard-coded schema-valid response (dev/testing)
LLM_STUB=0

# false = kill switch: skip the model entirely, return 503 (safe fallback)
LLM_ENABLED=true

# Client-side request timeout, in seconds. Must be <= 60.
LLM_TIMEOUT_SECONDS=30
